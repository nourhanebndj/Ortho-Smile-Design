rules_version = '2';

// Règles de sécurité Firestore — Ortho Smile Design
// - Le public peut lire : paramètres du cabinet, services, jours fermés, créneaux occupés (sans données personnelles).
// - Le public peut seulement CRÉER une demande de rendez-vous "en attente" + bloquer le créneau correspondant.
// - Tout le reste (patients, versements, stock, comptabilité…) est réservé aux administrateurs
//   connectés avec un compte e-mail/mot de passe (Firebase Authentication).
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // compte e-mail/mot de passe créé dans la console (l'inscription publique est désactivée)
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password';
    }
    // La date demandée doit être entre aujourd'hui (tolérance fuseau horaire) et +92 jours
    function validBookingDate(dateStr) {
      let p = dateStr.split('-');
      let day = timestamp.date(int(p[0]), int(p[1]), int(p[2]));
      let today = timestamp.date(request.time.year(), request.time.month(), request.time.day());
      return day >= today - duration.value(1, 'd') && day <= today + duration.value(92, 'd');
    }
    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }
    function slotKey(d) {
      return d.date + '_' + d.time.replace(':', '');
    }

    // Accès complet pour les administrateurs, sur toutes les collections
    match /{collection}/{docId} {
      allow read, write: if isAdmin();
    }

    // Lecture publique (site vitrine)
    match /settings/{docId} { allow read: if true; }
    match /services/{docId} { allow read: if true; }
    match /closures/{docId} { allow read: if true; }

    // Créneaux occupés : aucune donnée personnelle, juste date/heure
    match /busy/{slotId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date', 'time', 'apptId'])
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.apptId is string
        && slotId == slotKey(request.resource.data)
        && !exists(docPath('closures', request.resource.data.date))
        // le rendez-vous associé doit être créé dans la même opération
        && !exists(docPath('appointments', request.resource.data.apptId))
        && getAfter(docPath('appointments', request.resource.data.apptId)).data.date == request.resource.data.date
        && getAfter(docPath('appointments', request.resource.data.apptId)).data.time == request.resource.data.time
        && getAfter(docPath('appointments', request.resource.data.apptId)).data.status == 'pending';
    }

    // Demande de rendez-vous en ligne (création uniquement)
    function validWebBooking(apptId, d) {
      return d.keys().hasOnly(['name', 'phone', 'serviceId', 'date', 'time', 'notes', 'status', 'source', 'ref', 'createdAt'])
        && d.keys().hasAll(['name', 'phone', 'serviceId', 'date', 'time', 'status', 'source', 'createdAt'])
        && d.status == 'pending'
        && d.source == 'web'
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 120 && !d.name.matches('.*[<>{}].*')
        && d.phone is string && d.phone.matches('^[0-9+ ().-]{9,30}$')
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 1000 && !d.notes.matches('(?s).*[<>].*')))
        && (!('ref' in d) || (d.ref is string && d.ref.matches('^[A-Za-z0-9]{1,12}$')))
        && d.date is string && d.date.matches('^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && validBookingDate(d.date)
        && d.time is string && d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.serviceId is string && d.serviceId.size() <= 64 && exists(docPath('services', d.serviceId))
        && d.createdAt == request.time
        // le créneau doit être réservé dans la même opération (impossible s'il est déjà pris)
        && getAfter(docPath('busy', slotKey(d))).data.apptId == apptId;
    }
    match /appointments/{apptId} {
      allow create: if validWebBooking(apptId, request.resource.data);
    }
  }
}
